{
  "name": "insigndigital/resellerclub-php-api",
  "description": "Modern PHP SDK for ResellerClub / LogicBoxes HTTP API (KB 744)",
  "license": "MIT",
  "authors": [
    {
      "name": "Heron Santos",
      "email": "heronsantos@outlook.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "guzzlehttp/guzzle": "^7.8",
    "ext-simplexml": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "ResellerClub\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ResellerClub\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
